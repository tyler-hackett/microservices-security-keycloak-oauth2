# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Every value below is a placeholder.

# Host name or LAN IP address that both your browser and the containers use
# to reach Keycloak. The issuer in every token is built from this value, and
# token exchange fails if the services see a different issuer.
KC_HOSTNAME=<your-lan-ip>

# Bootstrap admin for the local Keycloak container (admin console login).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme

# PostgreSQL superuser password, used once to initialize the database.
POSTGRES_PASSWORD=changeme
# Password for the cafuser application account (created by caf-database/caf-database.sh).
DATABASE_PASSWORD=changeme

# LocalStack S3 credentials. Any values work locally; use the same values
# in the AWS CLI profile you use to create the caf-images bucket.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Keycloak client secrets for caf-realm.
# Admin console: caf-realm > Clients > caf-webapp (or caf-rest) > Credentials > Regenerate.
CAF_WEBAPP_CLIENT_SECRET=changeme
CAF_REST_CLIENT_SECRET=changeme

# Secret for the admin-cli client in the master realm, which the webapp uses
# (client credentials grant) to create and list users.
# Admin console: master > Clients > admin-cli > Credentials.
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme
